@model InventoryManagement.Models.Product
@{
    ViewBag.Title = "Delete Product";
}

<h1>Delete Product</h1>
<div class="panel">
    <h2>@Model.Name</h2>
    <p><strong>Category:</strong> @Model.Category | <strong>Quantity:</strong> @Model.Quantity</p>
    <p><strong>Price:</strong> INR @Model.Price.ToString("F2")</p>
    <p style="color: #b91c1c; font-weight: 500;">Are you sure you want to delete this product?</p>

    <form action="/Product/Delete/@Model.Id" method="post" style="margin-top: 16px;">
        @Html.AntiForgeryToken()
        <button type="submit" class="danger">Delete Product</button>
        <a href="/Product" class="secondary">Cancel</a>
    </form>
</div>
